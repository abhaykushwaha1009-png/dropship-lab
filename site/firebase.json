{
  "hosting": {
    "site": "dropship-lab-974ef",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.py",
      "__pycache__/**",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|avif|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
        ]
      }
    ]
  }
}
